LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Groq on-demand: qwen3.8-27b caps output at 1000 tokens/min (OTPM),
# which cannot fit a full guide; gpt-oss-120b accepts the writer's output.
LLM_MODEL=openai/gpt-oss-120b
LLM_AUTO_SELECT=true
LLM_PREFER_ORDER=
PH_API_TOKEN=
DISCORD_WEBHOOK_URL=

TZ_LABEL=Asia/Kolkata
GUIDES_PER_RUN=3
SOURCE_MODE=merge
HISTORY_DAYS=40
DRY_RUN=false
EMAIL_LLM_API_KEY=
EMAIL_LLM_BASE_URL=https://api.xkiro.com/v1
EMAIL_LLM_MODEL=sensenova/sensenova-6.8-flash-lite
EMAIL_LLM_AUTO_SELECT=true
EMAIL_LLM_PREFER_ORDER=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SENDER=noreply@redditmail.com
GMAIL_LOOKBACK_DAYS=7
GMAIL_ALLOWED_SUBREDDITS=selfhosted,appideas,indiehackers,startups,startup_ideas,sideproject
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=guides
CLOUDFLARE_PAGES_BRANCH=main
